def copyfile():    
    src = '/home/jack/Desktop/Media_Studio/static/projects/result_jan11.mp4'
    if not os.path.exists(src):
        print(f"Warning: {src} does not exist. Avatar rendering may have failed.")
        return "Failed: Output not found."
    dst = '/home/jack/Desktop/Media_Studio/static/temp_exp/avatarX.mp4'
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy(src, dst)
    avatars_dir = '/home/jack/Desktop/Media_Studio/static/avatars'
    os.makedirs(avatars_dir, exist_ok=True)
    ndst = os.path.join(avatars_dir, f"{uuid.uuid4()}.mp4")
    shutil.copy(src, ndst)
    return f"Copied: {dst}"

