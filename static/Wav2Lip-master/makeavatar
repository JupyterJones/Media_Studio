def refresh_avatar():
    try:
        # Run the script using subprocess
        subprocess.run(
            [
                '/home/jack/Desktop/Media_Studio/wav2lip/venv_wav2lip/bin/python',
                '/home/jack/Desktop/Media_Studio/wav2lip/inference.py',
                '--checkpoint_path', '/home/jack/Desktop/Media_Studio/wav2lip/checkpoints/wav2lip.pth',
