API_URL = "http://localhost:11434/api/generate"
def send_prompt():
    model = model_var.get()
    prompt = prompt_entry.get("1.0", tk.END).strip()
    if prompt == "":
        output_text.insert(tk.END, "\nPlease enter a prompt.\n")
        return
    ic("MODEL:", model)
    ic("PROMPT:", prompt)
    output_text.insert(tk.END, "\n=============================\n")
    output_text.insert(tk.END, f"MODEL: {model}\n")
    output_text.insert(tk.END, f"PROMPT:\n{prompt}\n\n")
    try:
        payload = {
            "model": model,
            "prompt": prompt
        }
        response = requests.post(
            API_URL,
            json=payload,
            stream=True,
            timeout=800
        )
        full_text = ""
        for line in response.iter_lines():
            if line:
                decoded = line.decode("utf-8")
                data = json.loads(decoded)
                ic(data)
                if "response" in data:
                    chunk = data["response"]
                    full_text += chunk
                    output_text.insert(tk.END, chunk)
                    output_text.update()
        output_text.insert(tk.END, "\n\n")
        output_text.see(tk.END)
    except Exception as e:
        ic("ERROR:", e)
        output_text.insert(tk.END, f"\nERROR:\n{e}\n")
    prompt_entry.delete("1.0", tk.END)
    prompt_entry.focus_set()
def clear_output():
    output_text.delete("1.0", tk.END)
