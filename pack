<script>
(function () {
  var cfg = window.__KC || {};

  // The zips are too big for one static file, so they ship as ≤ 20 MB parts (cfg.packZips) and
  // the browser joins them: streamed straight to disk where the File System Access API exists,
  // otherwise as one Blob. The href stays as the fallback (server-side stream) for old browsers.
  var status = document.getElementById('pack-zip-status');
  var say = function (text) { status.hidden = !text; status.textContent = text || ''; };
  var joinZip = function (spec, onProgress) {
    var picker = window.showSaveFilePicker
      ? window.showSaveFilePicker({ suggestedName: spec.filename, types: [{ description: 'ZIP archive', accept: { 'application/zip': ['.zip'] } }] })
          .then(function (handle) { return handle.createWritable(); }, function (err) { if (err && err.name === 'AbortError') throw err; return null; })
      : Promise.resolve(null);
    return picker.then(function (sink) {
      var received = 0, chunks = [];
      var next = function (i) {
        if (i >= spec.parts.length) return Promise.resolve();
        return fetch(spec.parts[i].path).then(function (res) {
          if (!res.ok || !res.body) throw new Error('part ' + i + ' failed: ' + res.status);
          var reader = res.body.getReader();
          var pump = function () {
            return reader.read().then(function (r) {
              if (r.done) return;
              received += r.value.byteLength;
              onProgress(received / spec.size);
              return (sink ? sink.write(r.value) : (chunks.push(r.value), Promise.resolve())).then(pump);
            });
          };
          return pump();
        }).then(function () { return next(i + 1); });
      };
      return next(0).then(function () {
        if (received !== spec.size) throw new Error('short download: ' + received + ' of ' + spec.size);
        if (sink) return sink.close();
        var url = URL.createObjectURL(new Blob(chunks, { type: 'application/zip' }));
        var link = document.createElement('a');
        link.href = url; link.download = spec.filename;
        document.body.appendChild(link); link.click(); link.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
      }, function (err) { if (sink) sink.abort().catch(function () {}); throw err; });
    });
  };
  var busy = false;
  Array.prototype.forEach.call(document.querySelectorAll('#pack-zips a[data-zip]'), function (a) {
    var spec = (cfg.packZips || {})[a.getAttribute('data-zip')];
    if (!spec || !window.fetch || !window.ReadableStream || !window.Blob) return; // plain link
    var label = a.textContent;
    a.addEventListener('click', function (ev) {
      ev.preventDefault();
      if (busy) return;
      busy = true;
      say('Preparing ' + spec.filename + '…');
      joinZip(spec, function (f) { a.textContent = 'Downloading… ' + Math.round(f * 100) + '%'; })
        .then(function () { say(spec.filename + ' saved.'); }, function (err) {
          if (err && err.name === 'AbortError') { say(''); return; }
          say('Download failed (' + (err && err.message ? err.message : err) + '). Trying the direct link…');
          window.location.href = a.href;
        })
        .then(function () { a.textContent = label; busy = false; });
    });
  });

  var el = function (tag, attrs, children) {
    var n = document.createElement(tag);
    Object.keys(attrs || {}).forEach(function (k) { if (k === 'text') n.textContent = attrs[k]; else n.setAttribute(k, attrs[k]); });
    (children || []).forEach(function (c) { n.appendChild(c); });
    return n;
  };
  var IMG = '/pack/img/';
  var typeLabel = function (t) {
    t = String(t || '');
    if (/corner/i.test(t)) return 'Corner sofa cover';
    if (/cushion/i.test(t)) return 'Cushion cover';
    if (/throw/i.test(t)) return 'Sofa throw';
    if (/sofa cover/i.test(t)) return 'Sofa cover';
    return t;
  };
  var joinList = function (a) { return (a || []).filter(Boolean).join(', '); };

  fetch('/pack/pack.json', { cache: 'no-cache' }).then(function (r) { return r.json(); }).then(function (pack) {
    var products = pack.products || [];
    var grid = document.getElementById('product-grid');
    document.getElementById('pack-loading').hidden = true;
    document.getElementById('pack-count').textContent = String(products.length);

    products.forEach(function (p) {
      var facts = p.facts || {};
      var photos = (p.images || []).filter(function (im) { return im.kind !== 'graphic'; });
      var hero = IMG + (p.hero || (photos[0] && photos[0].file) || '');
      var meta = [
        el('span', { class: 'pill', text: typeLabel(facts.product_type || p.product_type) }),
        el('span', { class: 'muted', text: photos.length + (photos.length === 1 ? ' photo' : ' photos') })
      ];
      var details = [];
      if ((facts.colours || []).length) details.push(el('li', {}, [el('strong', { text: 'Colour: ' }), document.createTextNode(joinList(facts.colours))]));
      if (facts.fabric) details.push(el('li', {}, [el('strong', { text: 'Fabric: ' }), document.createTextNode(facts.fabric)]));
      if ((facts.sizes || []).length) details.push(el('li', {}, [el('strong', { text: 'Sizes: ' }), document.createTextNode(joinList(facts.sizes))]));
      var pdp = facts.pdp_url ? el('a', { href: facts.pdp_url, target: '_blank', rel: 'noopener', text: 'Product page ↗' }) : null;

      var all = el('div', { class: 'gallery all-photos' }, photos.map(function (im, i) {
        var img = el('img', { src: IMG + im.file, alt: (p.title || '') + ' — photo ' + (i + 1), loading: 'lazy' });
        return el('figure', {}, [el('a', { href: IMG + im.file, target: '_blank', rel: 'noopener' }, [img]), el('figcaption', { text: (i + 1) + ' / ' + photos.length })]);
      }));
      var expandable = el('details', { class: 'all-photos-toggle' }, [el('summary', { text: 'All ' + photos.length + ' photos' }), all]);

      var card = el('article', { class: 'card product' }, [
        el('a', { class: 'product-hero', href: hero, target: '_blank', rel: 'noopener' }, [el('img', { src: hero, alt: p.title || '', loading: 'lazy', width: '2000', height: '1333' })]),
        el('div', { class: 'product-meta' }, meta),
        el('h3', { text: p.title || p.handle || 'Product' }),
        el('ul', { class: 'product-facts' }, details),
        pdp ? el('p', {}, [pdp]) : el('span'),
        expandable
      ]);
      grid.appendChild(card);
    });
    if (!products.length) grid.appendChild(el('p', { class: 'muted', text: 'The pack is being prepared. Check back shortly.' }));
  }).catch(function () {
    var l = document.getElementById('pack-loading'); l.hidden = false; l.textContent = 'Could not load the pack. Please refresh.';
  });
})();
</script>
